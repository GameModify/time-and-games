{
  "name": "time-and-games",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module",
  "description": "Локальный учёт времени и библиотеки игр, фильмов и сериалов",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server/index.ts\" \"vite --host 127.0.0.1\"",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "check": "vue-tsc --noEmit && node scripts/check-architecture.ts && eslint src server tests scripts *.config.ts --max-warnings=0 && prettier --check \"src/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\" tsconfig.json",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.config.ts\" tsconfig.json",
    "test": "node --test --test-concurrency=2 tests/*.test.ts",
    "quality:audit": "node scripts/quality/verify-project.ts --audit",
    "verify": "node scripts/quality/verify-project.ts",
    "package:release": "node scripts/release/package.ts",
    "smoke:release": "node scripts/release/smoke.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.35.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "jiti": "^2.7.0",
    "lucide-vue-next": "^0.468.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vue": "^3.5.18",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
